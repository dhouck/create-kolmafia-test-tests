{
	"name": "create-kolmafia-test-tests",
	"version": "0.0.0",
	"author": "Daniel Houck <Software@DRHouck.me>",
	"homepage": "",
	"license": "MIT",
	"scripts": {
		"build": "rspack",
		"build:dev": "rspack -m dev",
		"build:watch": "rspack --watch -m dev",
		"test": "vitest run",
		"test:watch": "vitest watch --no-clearScreen",
		"watch": "concurrently --prefix \"[{name} {time}]\" -t \"HH:mm:ss\" --pad-prefix \"yarn:*:watch\"",
		"format": "eslint src --fix --ext .ts && NODE_OPTIONS=\"--experimental-strip-types\" prettier --write --list-different .",
		"lint": "eslint src --ext .ts &&  NODE_OPTIONS=\"--experimental-strip-types\" prettier --check .",
		"install-mafia": "yarn run build && create-kolmafia-script --install"
	},
	"dependencies": {
		"kolmafia": "latest",
		"libram": "^0.11.29"
	},
	"type": "module",
	"devDependencies": {
		"@babel/core": "^7.29.0",
		"@babel/preset-env": "^7.29.0",
		"@babel/preset-typescript": "^7.28.5",
		"@eslint/js": "^9.39.2",
		"@rspack/cli": "^2.2.1",
		"@rspack/core": "^2.2.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/babel__core": "^7.20.5",
		"@types/babel__preset-env": "^7.10.0",
		"@types/node": "^25.3.0",
		"babel-loader": "^10.1.1",
		"concurrently": "^10.0.5",
		"create-kolmafia-script": "latest",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-libram": "^0.6.0",
		"jiti": "^2.6.1",
		"prettier": "^3.8.1",
		"ts-checker-rspack-plugin": "^1.6.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	},
	"packageManager": "yarn@4.18.0"
}
